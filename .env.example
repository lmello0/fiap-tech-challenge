DB_URL=
DB_USER=
DB_PASSWORD=

# HS256 signing key — must be at least 32 bytes
JWT_SECRET=
JWT_ISSUER=

# First-run only: creates a MANAGER if this email has no user yet. A random password is
# generated and logged once at startup — rotate it via POST /auth/password, then unset these.
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_FIRST_NAME=
BOOTSTRAP_MANAGER_LAST_NAME=
BOOTSTRAP_MANAGER_DOCUMENT_TYPE=
BOOTSTRAP_MANAGER_DOCUMENT_CODE=
BOOTSTRAP_MANAGER_PHONE=
