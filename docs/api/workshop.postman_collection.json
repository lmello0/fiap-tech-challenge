              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "workshop-cli"
                },
                {
                  "key": "username",
                  "value": "attendant"
                },
                {
                  "key": "password",
                  "value": "attendant"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/workshop/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "workshop",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
