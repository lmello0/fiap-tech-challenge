        {
          "name": "9.1 E-mails do cliente no Mailpit",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailpitUrl}}/api/v1/messages?limit=200",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function(){}, 3000); // o envio e assincrono (evento + Mailpit)"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const email = pm.collectionVariables.get('customerEmail'), number = pm.collectionVariables.get('workOrderNumber1');",
                  "const subjects = pm.response.json().messages.filter(m => m.To[0].Address === email && m.Subject.includes(number)).map(m => m.Subject);",
                  "console.log(subjects.join(' | '));",
                  "pm.test('e-mail de recebimento', () => pm.expect(subjects.some(s => /received/i.test(s))).to.be.true);",
                  "pm.test('e-mail da mudanca apos a aprovacao', () => pm.expect(subjects.length).to.be.above(1));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Alternativa visual: abrir http://localhost:8025 no navegador."
    },
