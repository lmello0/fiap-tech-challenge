      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "webhookSecret",
      "value": "demo-webhook-secret"
    },
    {
      "key": "serviceId",
      "value": "0198a000-0000-7000-8000-000000000201"
    },
    {
      "key": "partId",
      "value": "0198a000-0000-7000-8000-000000000301"
    },
    {
      "key": "demoCustomerId",
      "value": "0198a000-0000-7000-8000-000000000001"
    },
    {
      "key": "webhookDecision",
      "value": "APPROVED"
