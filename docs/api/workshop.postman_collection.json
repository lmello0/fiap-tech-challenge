    {
      "name": "5. External budget decision (webhook)",
      "item": [
        {
          "name": "Signed webhook (HMAC-SHA256)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/webhooks/budget-decisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "budget-decisions"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret=pm.collectionVariables.get('webhookSecret');",
                  "const ts=Math.floor(Date.now()/1000).toString();",
                  "const body=JSON.stringify({eventId:crypto.randomUUID?crypto.randomUUID():pm.variables.replaceIn('{{$guid}}'),workOrderNumber:pm.collectionVariables.get('workOrderNumber'),budgetId:pm.collectionVariables.get('budgetId'),decision:pm.collectionVariables.get('webhookDecision')||'APPROVED',reason:'decided by the partner system'});",
                  "const signature='sha256='+CryptoJS.HmacSHA256(ts+'.'+body,secret).toString();",
                  "pm.request.body.raw=body;",
                  "pm.request.headers.upsert({key:'X-Timestamp',value:ts});",
                  "pm.request.headers.upsert({key:'X-Signature',value:signature});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.response.to.have.status(200));",
                  "pm.test('applied', () => pm.expect(pm.response.json().result).to.be.oneOf(['APPLIED','DUPLICATE']));"
                ]
              }
            }
          ]
        }
      ]
    },
