    {
      "name": "2. Abrir OS com cliente e veiculo NOVOS (passo 2)",
      "item": [
        {
          "name": "2.1 Abrir OS - cliente e veiculo novos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/work-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"document\": \"{{customerDocument}}\",\n    \"name\": \"Ana Souza\",\n    \"email\": \"{{customerEmail}}\",\n    \"phone\": \"11999990000\"\n  },\n  \"vehicle\": {\n    \"plate\": \"{{vehiclePlate1}}\",\n    \"brand\": \"Fiat\",\n    \"model\": \"Argo\",\n    \"year\": 2022\n  },\n  \"complaint\": \"Barulho ao frear\",\n  \"items\": [\n    {\n      \"type\": \"SERVICE\",\n      \"referenceId\": \"{{serviceId}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendantToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera CPF valido, placa e e-mail NOVOS a cada execucao do passo 2.",
                  "function cpf(){const d=[];for(let i=0;i<9;i++)d.push(Math.floor(Math.random()*10));",
                  "const dv=(n,w)=>{let s=0;for(let i=0;i<n;i++)s+=d[i]*(w-i);const r=(s*10)%11;return r===10?0:r;};",
                  "d.push(dv(9,10));d.push(dv(10,11));return d.join('');}",
                  "const L='ABCDEFGHIJKLMNOPQRSTUVWXYZ';const l=()=>L[Math.floor(Math.random()*26)];",
                  "const dg=()=>Math.floor(Math.random()*10);",
                  "const plate=()=>l()+l()+l()+dg()+l()+dg()+dg();",
                  "const doc=cpf();",
                  "pm.collectionVariables.set('customerDocument',doc);",
                  "pm.collectionVariables.set('customerEmail','roteiro-'+doc+'@example.com');",
                  "pm.collectionVariables.set('vehiclePlate1',plate());",
                  "pm.collectionVariables.set('vehiclePlate2',plate());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const wo = pm.response.json();",
                  "pm.test('status RECEIVED', () => pm.expect(wo.status).to.eql('RECEIVED'));",
                  "pm.collectionVariables.set('workOrderId1', wo.id);",
                  "pm.collectionVariables.set('workOrderNumber1', wo.number);",
                  "pm.collectionVariables.set('customerId', wo.customer.id);",
                  "pm.collectionVariables.set('vehicleId1', wo.vehicle.id);",
                  "pm.collectionVariables.unset('webhookEventId');"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Mostrar o cliente que foi criado",
          "request": {
