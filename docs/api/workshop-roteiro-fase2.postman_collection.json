          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/work-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"document\": \"{{customerDocument}}\",\n    \"name\": \"Nome Diferente (ignorado)\",\n    \"email\": \"outro-email@example.com\",\n    \"phone\": \"11999990000\"\n  },\n  \"vehicle\": {\n    \"plate\": \"{{vehiclePlate2}}\",\n    \"brand\": \"Fiat\",\n    \"model\": \"Argo\",\n    \"year\": 2022\n  },\n  \"complaint\": \"Barulho ao frear\",\n  \"items\": [\n    {\n      \"type\": \"SERVICE\",\n      \"referenceId\": \"{{serviceId}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendantToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Mesmo documento, mas nome e e-mail diferentes no corpo: o cliente existente e reaproveitado e NAO e sobrescrito."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const wo = pm.response.json();",
                  "pm.test('mesmo cliente reaproveitado', () => pm.expect(wo.customer.id).to.eql(pm.collectionVariables.get('customerId')));",
                  "pm.test('dados do cliente nao sobrescritos', () => pm.expect(wo.customer.name).to.eql('Ana Souza'));",
                  "pm.test('veiculo novo', () => pm.expect(wo.vehicle.id).to.not.eql(pm.collectionVariables.get('vehicleId1')));",
                  "pm.collectionVariables.set('workOrderId2', wo.id);",
                  "pm.collectionVariables.set('vehicleId2', wo.vehicle.id);"
                ]
              }
            }
          ]
        },
