    {
      "name": "2. Work order flow (staff)",
      "item": [
        {
          "name": "Open work order (customer and vehicle in the body)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/work-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "work-orders"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendantToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\"document\": \"{{customerDocument}}\", \"name\": \"Ana Souza\", \"email\": \"{{customerEmail}}\", \"phone\": \"11999990000\"},\n  \"vehicle\": {\"plate\": \"{{vehiclePlate}}\", \"brand\": \"Fiat\", \"model\": \"Argo\", \"year\": 2022},\n  \"complaint\": \"Noise when braking\",\n  \"items\": [{\"type\": \"SERVICE\", \"referenceId\": \"{{serviceId}}\", \"quantity\": 1}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function cpf(){const d=[];for(let i=0;i<9;i++)d.push(Math.floor(Math.random()*10));",
                  "const dv=(n,w)=>{let s=0;for(let i=0;i<n;i++)s+=d[i]*(w-i);const r=(s*10)%11;return r===10?0:r;};",
                  "d.push(dv(9,10));d.push(dv(10,11));return d.join('');}",
                  "const L='ABCDEFGHIJKLMNOPQRSTUVWXYZ';const l=()=>L[Math.floor(Math.random()*26)];",
                  "const doc=cpf();",
                  "pm.collectionVariables.set('customerDocument',doc);",
                  "pm.collectionVariables.set('customerEmail','postman-'+doc+'@example.com');",
                  "pm.collectionVariables.set('vehiclePlate',l()+l()+l()+Math.floor(Math.random()*10)+l()+Math.floor(Math.random()*10)+Math.floor(Math.random()*10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const wo=pm.response.json();",
                  "pm.collectionVariables.set('workOrderId',wo.id);pm.collectionVariables.set('workOrderNumber',wo.number);pm.collectionVariables.set('customerId',wo.customer.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add an item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
