    },
    {
      "name": "4. Listagem priorizada (passo 4)",
      "item": [
        {
          "name": "4.1 Fila priorizada (sem finalizadas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/work-orders?size=100",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendantToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rank = {IN_EXECUTION:0, WAITING_PARTS:1, WAITING_APPROVAL:2, IN_DIAGNOSIS:3, RECEIVED:4};",
                  "",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const st = pm.response.json().content.map(w => w.status);",
                  "pm.test('sem COMPLETED/DELIVERED/CANCELLED', () => pm.expect(st.filter(s => ['COMPLETED','DELIVERED','CANCELLED'].includes(s))).to.eql([]));",
                  "const r = st.map(s => rank[s]);",
                  "pm.test('ordenada por prioridade de status', () => pm.expect(r).to.eql([...r].sort((a,b) => a-b)));"
                ]
              }
            }
          ]
        }
      ]
    },
