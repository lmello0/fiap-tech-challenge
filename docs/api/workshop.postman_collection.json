                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('attendantToken', pm.response.json().access_token);",
                  "pm.collectionVariables.set('attendantRefresh', pm.response.json().refresh_token);"
