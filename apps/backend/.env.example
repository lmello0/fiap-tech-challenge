DB_URL=
DB_USER=
DB_PASSWORD=

# HS256 signing key — must be at least 32 bytes
JWT_SECRET=
JWT_ISSUER=

# HMAC signing key for Budget Decision Tokens (the emailed approve/refuse link) — deliberately a
# separate secret from JWT_SECRET so a leak of one never weakens the other. At least 32 bytes.
BUDGET_DECISION_TOKEN_SECRET=

# The SPA's origin — auth emails link to its routes (/verify-email, /reset-password,
# /confirm-email-change), never to this API. Defaults to the Angular dev server.
APP_BASE_URL=

# First-run only: creates a MANAGER if this email has no user yet. A random password is
# generated and logged once at startup — rotate it via POST /auth/password, then unset these.
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_FIRST_NAME=
BOOTSTRAP_MANAGER_LAST_NAME=
BOOTSTRAP_MANAGER_DOCUMENT_TYPE=
BOOTSTRAP_MANAGER_DOCUMENT_CODE=
BOOTSTRAP_MANAGER_PHONE=
